# Copy to .env.local and fill in. See docs/setup.md for where each value lives.
#
# Keep comments on their own lines. Node's --env-file parser does not reliably
# strip a trailing "# comment" after a value, so an inline one can end up as
# part of the value.

# --- Supabase ---------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses row level security — never prefix this NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Postgres ---------------------------------------------------------------
# Two connection strings, not interchangeable.

# Pooled (transaction mode), port 6543. Used by the app at runtime.
DATABASE_URL=

# Direct, port 5432. Used by drizzle-kit for migrations.
# If your network is IPv4-only, use the Session pooler string (port 5432 on the
# pooler host) here instead — direct connections are IPv6-only on newer projects.
DIRECT_DATABASE_URL=

# --- Razorpay (the only payment provider) -----------------------------------

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Public key for checkout.js
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# --- App --------------------------------------------------------------------

NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Razorpay plan ids ------------------------------------------------------
# Razorpay dashboard → Subscriptions → Plans. A plan fixes its currency when
# it is created, so each currency needs its own pair. The annual plan is priced
# at ten months (two months free), which is the main lever on lifetime value —
# see src/lib/billing/pricing.ts for the reasoning.

# INR, charged to customers in India. ₹199/month and ₹1,999/year.
RAZORPAY_PLAN_ID_MONTHLY=
RAZORPAY_PLAN_ID_ANNUAL=

# USD, charged to everyone else. $6/month and $60/year.
# Requires International Payments to be enabled on the Razorpay account — a
# separate activation. Leave these blank until it is: the billing page then
# tells international users that Pro has not reached their region yet, instead
# of offering a checkout that would fail.
RAZORPAY_PLAN_ID_MONTHLY_USD=
RAZORPAY_PLAN_ID_ANNUAL_USD=

# --- Cron -------------------------------------------------------------------
# Shared secret Vercel sends as `Authorization: Bearer <value>` on cron
# requests. Without it, /api/cron/reconcile is a public downgrade trigger.
CRON_SECRET=
