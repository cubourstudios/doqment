# Copy to .env.local and fill in. See docs/setup.md for where each value lives.
#
# Keep comments on their own lines. Node's --env-file parser does not reliably
# strip a trailing "# comment" after a value, so an inline one can end up as
# part of the value.

# --- Supabase ---------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses row level security — never prefix this NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Postgres ---------------------------------------------------------------
# Two connection strings, not interchangeable.

# Pooled (transaction mode), port 6543. Used by the app at runtime.
DATABASE_URL=

# Direct, port 5432. Used by drizzle-kit for migrations.
# If your network is IPv4-only, use the Session pooler string (port 5432 on the
# pooler host) here instead — direct connections are IPv6-only on newer projects.
DIRECT_DATABASE_URL=

# --- Razorpay (India / INR rail) --------------------------------------------

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Public key for checkout.js
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# --- Stripe (US / international rail) ---------------------------------------

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- App --------------------------------------------------------------------

NEXT_PUBLIC_APP_URL=http://localhost:3000
